rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid == '5JSYDqYRizMUZoLrOqQcCV0Cr603';
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Storage servers & admin configuration: strictly Admin-only read and write
    match /admin_storage/{docId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(docId) && request.resource.data.servers is list && request.resource.data.servers.size() <= 50;
      allow delete: if isAdmin() && isValidId(docId);
    }

    match /storage_servers/{serverId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(serverId);
    }

    match /site_stats/{statId} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create, update: if isValidId(statId) && request.resource.data.totalUsers is int && request.resource.data.totalUsers >= 1;
    }

    match /online_users/{visitorId} {
      allow get, list: if isAdmin();
      allow create, update: if isValidId(visitorId) && request.resource.data.online is bool && request.resource.data.lastSeen is int;
      allow delete: if isValidId(visitorId) || isAdmin();
    }
  }
}
