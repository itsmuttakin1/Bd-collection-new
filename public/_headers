# Cloudflare Pages Edge & Browser Cache Rules for X Tube (Locked to https://xtubeofficial.pages.dev)

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: https://xtubeofficial.pages.dev

/*.mp4
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: https://xtubeofficial.pages.dev
  Accept-Ranges: bytes

/*.webm
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: https://xtubeofficial.pages.dev
  Accept-Ranges: bytes

/*.jpg
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: https://xtubeofficial.pages.dev

/*.png
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: https://xtubeofficial.pages.dev

/*.webp
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: https://xtubeofficial.pages.dev

/sitemap.xml
  Cache-Control: public, max-age=300, s-maxage=300
  Content-Type: application/xml; charset=utf-8
